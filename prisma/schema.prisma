// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum AdminStatus {
  Active @map("active")

  @@map("admin_status")
}

model Admin {
  id           Int         @id @default(autoincrement())
  firstname    String
  lastname     String
  email        String      @unique
  profileImage String?     @map("profile_image")
  status       AdminStatus @default(Active)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  meta         AdminMeta?

  @@map("admin")
}

model AdminMeta {
  passwordSalt String? @map("password_salt")
  passwordHash String? @map("password_hash")
  admin        Admin   @relation(fields: [adminId], references: [id])
  adminId      Int     @unique() @map("admin_id")

  @@map("admin_meta")
}

enum UserStatus {
  Active  @map("active")
  Blocked @map("blocked")

  @@map("user_status")
}

model User {
  id           Int           @id @default(autoincrement())
  firstname    String
  lastname     String
  username     String?       @unique
  email        String        @unique
  dialCode     String?       @map("dial_code")
  mobile       String?       @unique
  profileImage String?       @map("profile_image")
  isVerified   Boolean       @default(false) @map("is_verified")
  country      String?
  status       UserStatus    @default(Active)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  meta         UserMeta?
  settings     UserSetting[]

  @@map("user")
}

model UserMeta {
  googleId     String? @unique @map("google_id")
  passwordSalt String? @map("password_salt")
  passwordHash String? @map("password_hash")
  user         User    @relation(fields: [userId], references: [id])
  userId       Int     @unique() @map("user_id")

  @@map("user_meta")
}

enum OtpTransport {
  Email  @map("email")
  Mobile @map("mobile")

  @@map("otp_transport")
}

model Otp {
  code             String
  attempt          Int          @default(1) @db.SmallInt
  lastSentAt       DateTime     @default(now()) @map("last_sent_at")
  retries          Int          @default(0) @db.SmallInt
  transport        OtpTransport
  target           String
  lastCodeVerified Boolean      @default(false) @map("last_code_verified")
  blocked          Boolean      @default(false)

  @@unique([transport, target])
  @@map("otp")
}

enum SettingType {
  Binary       @map("binary")
  MultiSelect  @map("multi_select")
  SingleSelect @map("single_select")

  @@map("setting_type")
}

enum SettingContext {
  User   @map("user")
  System @map("System")

  @@map("setting_context")
}

model Setting {
  id               Int             @id @default(autoincrement())
  mappedTo         String          @map("mapped_to")
  text             String          @default("")
  description      String          @default("")
  type             SettingType
  context          SettingContext
  default          Json
  isDefinedOptions Boolean         @map("is_defined_options")
  subSettings      Setting[]       @relation("SubSettings")
  dependsOn        Setting?        @relation("SubSettings", fields: [parentId], references: [id])
  parentId         Int?            @map("parent_id")
  options          SettingOption[]
  userSettings     UserSetting[]
  systemSettings   SystemSetting[]

  @@unique([context, mappedTo])
  @@map("setting")
}

model SettingOption {
  id        Int     @id @default(autoincrement())
  text      String  @default("")
  value     String
  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@unique([settingId, value])
  @@map("setting_option")
}

model UserSetting {
  selection Json
  user      User    @relation(fields: [userId], references: [id])
  userId    Int     @map("user_id")
  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@id([userId, settingId])
  @@map("user_setting")
}

model SystemSetting {
  selection Json
  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@id([settingId])
  @@map("system_setting")
}

enum NodeTag {
  Archive   @map("archive")
  Full      @map("full")
  RPC       @map("rpc")
  Validator @map("validator")
  Other     @map("other")

  @@map("node_tag")
}

model Node {
  id              Int      @id @default(autoincrement())
  type            String
  network         String
  name            String
  url             String   @unique
  thumbnailImage  String?  @map("thumbnail_image")
  minerAddress    String?  @map("consensus_address")
  contractAddress String?  @map("validator_address")
  operatorAddress String?  @map("operator_address")
  status          String   @default("active")
  tag             NodeTag  @default(Other)
  createdBy       Int?     @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("node")
}

enum WalletPurpose {
  Gas        @map("gas")
  Commission @map("commission")
  Payload    @map("payload")

  @@map("wallet_purpose")
}

model Wallet {
  id            Int      @id @default(autoincrement())
  name          String   @default("")
  walletAddress String   @default("0x05530552aa4DAB77b1bc363AAF5E6b14C053902F") @map("wallet_address")
  awsKeyID      String?  @map("aws_key_id")
  status        String   @default("active")
  createdBy     Int?     @default(1) @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedBy     Int?     @map("updated_by")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("wallet")
}

model Platform {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  status    String   @default("active")
  createdBy Int?     @default(1) @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform")
}

model Chain {
  id          Int      @id @default(autoincrement())
  chainId     Int      @default(1) @map("chain_id")
  chainName   String   @map("chain_name")
  rpc         String
  fallbackRpc String?  @map("fallback_rpc")
  status      String   @default("active")
  createdBy   Int?     @default(1) @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedBy   Int?     @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assets Asset[]
  action Action[]

  @@map("chain")
}

model Asset {
  id        Int      @id @default(autoincrement())
  assetName String   @map("asset_name")
  chainId   Int      @map("chain_id")
  address   String?
  isNative  Boolean  @default(false) @map("is_native")
  status    String   @default("active")
  createdBy Int?     @default(1) @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  chain Chain @relation(fields: [chainId], references: [id])

  @@map("asset")
}

enum ActionType {
  Read  @map("read")
  Write @map("write")

  @@map("action_type")
}

enum EntityType {
  Wallet @map("wallet")
  Node   @map("node")

  @@map("entity_type")
}

enum ActionCall {
  EOA @map("eoa")
  SC  @map("smart_contract")

  @@map("action_call")
}

model Action {
  id           Int        @id @default(autoincrement())
  actionName   String     @map("chain_name")
  description  String
  actionType   ActionType @default(Read) @map("action_type")
  chainID      Int        @map("chain_id")
  chain        Chain      @relation(fields: [chainID], references: [id])
  callType     ActionCall @default(EOA) @map("call_type")
  callMetaData Json?      @map("call_metadata")
  auto         Boolean    @default(false)
  status       String     @default("active")
  createdBy    Int?       @default(1) @map("created_by")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedBy    Int?       @map("updated_by")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("action")
}
